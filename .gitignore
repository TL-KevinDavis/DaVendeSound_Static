# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Visual Studio
.vs/
.vsidx/

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# Large media files - these should be in Azure Blob Storage, not Git
src/assets/images/*.mp4
src/assets/images/*.MP4
src/assets/images/*.mov
src/assets/images/*.MOV
src/assets/images/*.avi
src/assets/images/*.AVI
src/assets/images/*.jpg
src/assets/images/*.JPG
src/assets/images/*.jpeg
src/assets/images/*.JPEG
src/assets/images/*.png
src/assets/images/*.PNG
src/assets/images/*.gif
src/assets/images/*.GIF

# Keep only essential assets (logo, icons, backgrounds)
!src/assets/images/DaVendeLogo.jpg
!src/assets/images/DaVendeSoundLogo.gif
!src/assets/images/DaVendeSound.ico
!src/assets/images/black_abstract_stone_pattern_tileable.jpg

# System files
.DS_Store
Thumbs.db
