{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "DaVendeSoundStatic": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": false,
          "inlineStyle": false,
          "standalone": true,
          "style": "css",
          "skipTests": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              "src/DaVendeSound.ico",
              "src/sitemap.xml",
              "src/robots.txt"
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.css"
            ],
            "scripts": [
              "src/assets/lib/jquery/dist/jquery.min.js",
              "src/assets/lib/bootstrap/dist/js/bootstrap.min.js",
              "src/assets/lib/jquery-validation/dist/jquery.validate.min.js",
              "src/assets/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js",
              "src/assets/js/site.js"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4300
          },
          "configurations": {
            "production": {
              "buildTarget": "DaVendeSoundStatic:build:production"
            },
            "development": {
              "buildTarget": "DaVendeSoundStatic:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          }
        },
        "prerender": {
          "builder": "@angular-devkit/build-angular:prerender",
          "options": {
            "browserTarget": "DaVendeSoundStatic:build:production",
            "serverTarget": "DaVendeSoundStatic:server:production",
            "routes": [
              "/",
              "/dj-packages",
              "/photos-video",
              "/pro-sound",
              "/locations/brookhaven-ms",
              "/locations/biloxi-ms",
              "/locations/gulfport-ms",
              "/locations/hattiesburg-ms",
              "/locations/jackson-ms",
              "/locations/mccomb-ms",
              "/locations/meridian-ms",
              "/locations/natchez-ms",
              "/locations/oxford-ms",
              "/locations/southaven-ms",
              "/locations/starkville-ms",
              "/locations/vicksburg-ms",
              "/locations/mobile-al",
              "/locations/tuscaloosa-al",
              "/locations/alexandria-la",
              "/locations/baton-rouge-la",
              "/locations/lafayette-la",
              "/locations/minden-la",
              "/locations/monroe-la",
              "/locations/new-orleans-la",
              "/locations/ruston-la",
              "/locations/shreveport-la"
            ]
          }
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/DaVendeSoundStatic/server",
            "main": "src/main.server.ts",
            "tsConfig": "tsconfig.server.json"
          },
          "configurations": {
            "production": {
              "outputHashing": "media",
              "sourceMap": false,
              "optimization": true
            },
            "development": {
              "outputHashing": "media",
              "sourceMap": true,
              "optimization": false
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
